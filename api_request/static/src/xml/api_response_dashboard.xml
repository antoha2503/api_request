<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Рекурсивный компонент раскрывает вложенные JSON-объекты и списки в таблицы. -->
    <t t-name="api_request.JsonValueTable">
        <t t-if="isStructured">
            <button type="button" class="btn btn-link btn-sm p-0 text-start"
                    t-att-aria-expanded="state.expanded" t-on-click="toggleExpanded">
                <i t-att-class="state.expanded ? 'fa fa-chevron-down me-1' : 'fa fa-chevron-right me-1'"/>
                <t t-esc="toggleLabel"/>
            </button>
            <div t-if="state.expanded" class="table-responsive border rounded mt-2 p-2"
                 style="max-height: 40vh; overflow: auto;">
                <table class="table table-sm table-striped table-bordered mb-0">
                    <thead>
                        <tr>
                            <th t-foreach="tableData.columns" t-as="column" t-key="column" t-esc="column"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="tableData.rows" t-as="row" t-key="row_index">
                            <td t-foreach="row" t-as="cell" t-key="cell_index">
                                <JsonValueTable value="cell"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
        <t t-else="">
            <t t-esc="displayValue"/>
        </t>
    </t>

    <t t-name="api_request.ApiResponseDashboard">
        <div class="o_action">
            <div class="container-fluid p-4">
                <div class="card">
                    <div class="row g-0 p-3">
                        <section class="col-md-8 border-end pe-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3 class="mb-0" style="color: #7C5BBA;">Детали ответа</h3>
                                <!-- Экспорт скачивает таблицу текущего JSON-ответа как файл XLSX. -->
                                <div class="d-flex gap-2">
                                    <!-- Открывает окно выбора источника JSON, модели Odoo и полей сопоставления. -->
                                    <button t-if="selectedRequest &amp;&amp; parsedResponse.isJson" groups="base.group_system" type="button" class="btn btn-outline-primary"
                                            t-on-click="openImport">
                                        <i class="fa fa-download me-1"/>
                                        Импорт в Odoo
                                    </button>
                                    <button t-if="selectedRequest &amp;&amp; tableData" type="button" class="btn btn-primary"
                                            t-on-click="exportExcel">
                                        <i class="fa fa-file-excel-o me-1"/>
                                        Экспорт в Excel
                                    </button>
                                    <button t-if="selectedRequest" type="button" class="btn btn-secondary"
                                            t-on-click="copyCode">
                                        <i t-att-class="state.copied ? 'fa fa-check me-1' : 'fa fa-copy me-1'"/>
                                        <t t-esc="state.copied ? 'Скопировано' : 'Копировать JSON-код'"/>
                                    </button>
                                </div>
                            </div>
                            <t t-if="state.loading">
                                <p class="text-muted">Загрузка подключений...</p>
                            </t>
                            <t t-elif="selectedRequest">
                                <!-- Переключатели открывают табличное или исходное представление ответа. -->
                                <ul class="nav nav-tabs mb-3" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button type="button" role="tab"
                                                t-att-class="state.activeTab === 'table' ? 'nav-link active' : 'nav-link'"
                                                t-att-aria-selected="state.activeTab === 'table'"
                                                t-on-click="() => state.activeTab = 'table'">
                                            Таблица
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button type="button" role="tab"
                                                t-att-class="state.activeTab === 'json' ? 'nav-link active' : 'nav-link'"
                                                t-att-aria-selected="state.activeTab === 'json'"
                                                t-on-click="() => state.activeTab = 'json'">
                                            JSON
                                        </button>
                                    </li>
                                </ul>

                                <!-- Таблица автоматически строится по полям JSON-ответа. -->
                                <t t-if="state.activeTab === 'table'">
                                    <t t-if="tableData">
                                        <!-- Ограничиваем высоту и включаем прокрутку для длинных таблиц. -->
                                        <div class="table-responsive" style="max-height: 70vh; overflow: auto;">
                                            <table class="table table-sm table-striped table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th t-foreach="tableData.columns" t-as="column" t-key="column" t-esc="column"/>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="tableData.rows" t-as="row" t-key="row_index">
                                                        <td t-foreach="row" t-as="cell" t-key="cell_index">
                                                            <JsonValueTable value="cell"/>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                    <p t-else="" class="text-muted">Ответ не является JSON, таблицу построить нельзя.</p>
                                </t>

                                <!-- Полный JSON отображается с отступами и переносами строк. -->
                                <t t-elif="state.activeTab === 'json'">
                                    <pre class="p-3 bg-light border rounded" style="max-height: 70vh; overflow: auto;"><code t-esc="displayCode"/></pre>
                                </t>
                            </t>
                            <t t-else="">
                                <p class="text-muted">Нет подключённых API сервисов.</p>
                            </t>
                        </section>
                        <aside class="col-md-4 ps-4">
                            <h3 class="mb-3" style="color: #7C5BBA;">Список подключений</h3>
                            <div class="mb-3">
                                <label for="api_request_selector" class="form-label">Активное подключение</label>
                                <select id="api_request_selector" class="form-select"
                                        t-att-value="state.selectedId || ''"
                                        t-on-change="onRequestChange">
                                    <option t-foreach="state.requests" t-as="request" t-key="request.id"
                                            t-att-value="request.id" t-esc="request.name"/>
                                </select>
                            </div>
                            <p class="text-muted small">Выберите подключение, чтобы просмотреть его ответ.</p>
                        </aside>
                    </div>
                </div>
            </div>

            <!-- Модальное окно выбирает вложенный источник, модель и соответствия полей импорта. -->
            <div t-if="state.importOpen" class="modal d-block" tabindex="-1" role="dialog"
                 style="background-color: rgba(0, 0, 0, 0.35);">
                <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Импорт JSON в Odoo</h5>
                            <button type="button" class="btn-close" aria-label="Закрыть" t-on-click="closeImport"/>
                        </div>
                        <div class="modal-body">
                            <div t-if="state.importLoading" class="text-muted mb-3">Загрузка моделей и полей...</div>
                            <div t-if="state.importError" class="alert alert-danger" role="alert">
                                <t t-esc="state.importError"/>
                            </div>

                            <div t-if="state.importSources.length" class="mb-3">
                                <label for="api_import_source" class="form-label">Источник данных JSON</label>
                                <select id="api_import_source" class="form-select"
                                        t-att-value="state.importSource" t-on-change="onImportSourceChange">
                                    <option t-foreach="state.importSources" t-as="source" t-key="source.path"
                                            t-att-value="source.path" t-att-selected="source.path === state.importSource"
                                            t-esc="source.label"/>
                                </select>
                            </div>

                            <div t-if="state.importModels.length" class="mb-3">
                                <label for="api_import_model" class="form-label">Целевая модель Odoo</label>
                                <!-- Поле позволяет искать модель по названию или техническому имени. -->
                                <input id="api_import_model" type="search" class="form-control"
                                       autocomplete="off" placeholder="Начните вводить название, например res.partner"
                                       t-att-value="state.importModelSearch"
                                       t-att-aria-expanded="state.importModelDropdownOpen"
                                       t-on-input="onImportModelSearch" t-on-focus="onImportModelFocus"/>
                                <div t-if="state.importModelDropdownOpen &amp;&amp; filteredImportModels.length"
                                     class="list-group w-100 shadow mt-1"
                                     style="max-height: 280px; overflow-y: auto;">
                                    <button t-foreach="filteredImportModels" t-as="model" t-key="model.model"
                                            type="button" class="list-group-item list-group-item-action"
                                            t-att-data-model-name="model.model"
                                            t-on-click="onImportModelOptionClick"
                                            t-esc="model.label"/>
                                </div>
                                <div t-if="state.importModelDropdownOpen &amp;&amp; !filteredImportModels.length"
                                     class="list-group w-100 shadow mt-1">
                                    <div class="list-group-item text-muted">Модели не найдены.</div>
                                </div>
                            </div>

                            <t t-if="state.importMappings.length">
                                <p class="text-muted small">
                                    Найдено записей: <t t-esc="importRows.length"/>. Совпадающие имена полей сопоставлены автоматически.
                                </p>
                                <p t-if="hasStructuredMappings" class="alert alert-info py-2">
                                    Вложенные списки можно импортировать отдельно, выбрав их в источнике данных.
                                </p>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle">
                                        <thead>
                                            <tr>
                                                <th>Ключ JSON</th>
                                                <th>Поле модели Odoo</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.importMappings" t-as="mapping" t-key="mapping.sourceKey">
                                                <td>
                                                    <t t-esc="mapping.sourceKey"/>
                                                    <span t-if="mapping.isStructured" class="text-muted small"> (вложенные данные)</span>
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            t-att-data-source-key="mapping.sourceKey"
                                                            t-att-value="mapping.targetField"
                                                            t-att-disabled="mapping.isStructured || !state.importModel"
                                                            t-on-change="onImportMappingChange">
                                                        <option value="">Не импортировать</option>
                                                        <option t-foreach="state.importFields" t-as="field" t-key="field.name"
                                                                t-att-value="field.name">
                                                            <t t-esc="field.label"/> (<t t-esc="field.name"/>)
                                                            <t t-if="field.required"> — обязательно</t>
                                                        </option>
                                                    </select>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="text-muted small mb-0">
                                    Можно импортировать до 5000 строк за один раз. Вложенные значения и поля отношений пропускаются;
                                    обязательные поля модели должны иметь значение по умолчанию или быть сопоставлены.
                                </p>
                            </t>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" t-on-click="closeImport">Отмена</button>
                            <button type="button" class="btn btn-primary" t-att-disabled="!canImport || state.importing"
                                    t-on-click="importJsonData">
                                <t t-esc="state.importing ? 'Импорт...' : 'Импортировать'"/>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
